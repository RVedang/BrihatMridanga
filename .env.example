# Project URL only, e.g. https://xxxx.supabase.co  (no /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable or legacy anon key. Never put the service_role / secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to the actual deployment URL for OAuth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
